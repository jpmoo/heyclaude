#!/usr/bin/env node
// heyclaude chat                                                             (typed conversation)
// heyclaude settings                                                         (menus for everything below)
// heyclaude toggle | say <text> | type <text> | stop | new | interview | status | watch
// heyclaude voice [name]                                                     (list voices, or switch to one)
// heyclaude login | logout | account                                         (the Oracle's Claude login)
import { spawnSync } from "node:child_process";
import { existsSync, readFileSync, readdirSync } from "node:fs";
import { connect } from "node:net";
import { join, resolve } from "node:path";
import { homedir } from "node:os";
import { createInterface } from "node:readline";
import { BASICS, VOICES, fetchVoice, loadConfig, oracleEnv, restartDaemon, saveConfig } from "../lib.mjs";

const args = process.argv.slice(2);
const ORACLE = { login: ["auth", "login", "--claudeai"], logout: ["auth", "logout"], account: ["auth", "status", "--text"] };

if (!args.length || ["help", "-h", "--help"].includes(args[0])) {
  console.error([
    "heyclaude settings              menus: Ollama, the Oracle's login, voices, MCP servers, listening",
    "heyclaude chat                  a typed conversation",
    "heyclaude toggle                start listening, or send what has been said",
    "heyclaude say|type <text>       a turn answered aloud | in text only",
    "heyclaude stop | new            cut the answer off | start a fresh conversation",
    "heyclaude interview             the orientation interview",
    "heyclaude voice [name]          list voices | switch to one",
    "heyclaude login|logout|account  the Oracle's Claude login",
    "heyclaude status | watch        the daemon's state | its event stream",
    "heyclaude attach <file>...      put files on your next message in the chat window",
    "heyclaude reminders             timers and reminders that are set",
    "heyclaude key export | import   write down, or put back, the key that unlocks memory",
    "heyclaude tools                 the last few tool calls and what came back",
    "heyclaude admin <json>          what the settings window uses: { op, args }",
  ].join("\n"));
  process.exit(args.length ? 0 : 2);
}

// The file choosers, run from here and not from the plugin: a plugin waits
// only so long for a command it starts, and gave up on the chooser (closing
// it) before a file had been picked. Started through this command, detached,
// the chooser stays for as long as it is needed and reports back when done.
if (args[0] === "choose" || args[0] === "choose-folder") {
  const shell = join(homedir(), ".local", "bin", "noctalia");
  const folder = args[0] === "choose-folder";
  const picked = spawnSync("zenity", folder
    ? ["--file-selection", "--directory", "--title=A folder the assistant may read"]
    : ["--file-selection", "--multiple", "--separator=\n", "--title=Attach to your message"], { encoding: "utf8" });
  const paths = (picked.stdout ?? "").split("\n").filter(Boolean);
  if (folder) {
    if (paths[0]) {
      const ask = (request) => JSON.parse(spawnSync(process.argv[1], ["admin", JSON.stringify(request)], { encoding: "utf8" }).stdout || "{}");
      const folders = ask({ op: "config.get" }).folders ?? [];
      ask({ op: "config.set", args: { values: { folders: [...folders.filter((entry) => entry !== paths[0]), paths[0]] } } });
    }
    spawnSync(shell, ["msg", "panel-open", "jpmoo/morgan:settings"], { stdio: "ignore" });
  } else {
    for (const file of paths) spawnSync(shell, ["msg", "plugin", "jpmoo/morgan:link", "all", "attach", file], { stdio: "ignore" });
    spawnSync(shell, ["msg", "panel-open", "jpmoo/morgan:chat"], { stdio: "ignore" });
  }
  process.exit(0);
}

if (args[0] === "attach") {
  // Put files on the next message in the chat window, and bring the window up.
  const shell = join(homedir(), ".local", "bin", "noctalia");
  const files = args.slice(1).map((file) => resolve(file)).filter((file) => existsSync(file) || console.error(`heyclaude: no such file: ${file}`));
  for (const file of files) spawnSync(shell, ["msg", "plugin", "jpmoo/morgan:link", "all", "attach", file], { stdio: "ignore" });
  if (files.length) spawnSync(shell, ["msg", "panel-open", "jpmoo/morgan:chat"], { stdio: "ignore" });
  process.exit(files.length ? 0 : 1);
}

if (args[0] === "key") {
  // The key that memory, documents, pictures and the transcript are sealed
  // with lives in the login keyring. Written down somewhere safe, it can be
  // put back if the keyring is ever lost.
  const script = new URL("../keyring.py", import.meta.url).pathname;
  if (args[1] === "export") {
    const result = spawnSync("python3", [script, "--no-create"], { encoding: "utf8" });
    if (result.status !== 0) { console.error("heyclaude: there is no key in the login keyring"); process.exit(1); }
    console.error("This one line unlocks everything Morgan remembers. Keep it in a password manager or on paper, not in a file on this laptop.\n");
    console.log(result.stdout.trim());
  } else if (args[1] === "import") {
    console.error("Paste the key and press Enter. It replaces any key in the login keyring, and what was sealed with that one can no longer be read.");
    const line = readFileSync(0, "utf8").split("\n")[0];
    const result = spawnSync("python3", [script, "--set"], { input: line + "\n", encoding: "utf8" });
    if (result.status !== 0) { console.error(`heyclaude: ${result.stderr.trim().split("\n").pop()}`); process.exit(1); }
    restartDaemon();
    console.error("The key is in the login keyring, and the assistant has been restarted.");
  } else {
    console.error("usage: heyclaude key export | import");
    process.exit(2);
  }
  process.exit(0);
}

if (args[0] === "settings") {
  await (await import("../settings.mjs")).run();
  process.exit(0);
}

if (ORACLE[args[0]]) {
  const result = spawnSync("claude", [...ORACLE[args[0]], ...args.slice(1)], { env: oracleEnv(), stdio: "inherit" });
  process.exit(result.status ?? 1);
}

if (args[0] === "voice") {
  const config = loadConfig();
  const name = args[1];
  if (!name) {
    const current = config.voice ?? BASICS.voice;
    const installed = existsSync(VOICES) ? readdirSync(VOICES).filter((file) => file.endsWith(".onnx")).sort() : [];
    for (const file of installed) console.log(`${file.slice(0, -5) === current ? "*" : " "} ${file.slice(0, -5)}`);
    console.log("\nHear them all at https://rhasspy.github.io/piper-samples/ then: heyclaude voice <name>");
    process.exit(0);
  }
  const problem = fetchVoice(name);
  if (problem) {
    console.error(`heyclaude: ${problem}`);
    process.exit(1);
  }
  saveConfig({ ...config, voice: name });
  restartDaemon();
  spawnSync("sleep", ["1.5"]);
  args.splice(0, args.length, "speak", "Hello, this is how I sound now.");
}

const SOCKET = join(process.env.XDG_RUNTIME_DIR ?? "/tmp", "heyclaude.sock");

function open(command) {
  const socket = connect(SOCKET);
  socket.on("error", (error) => {
    console.error(`heyclaude: daemon not reachable (${error.code})`);
    process.exit(1);
  });
  socket.on("connect", () => socket.write(command + "\n"));
  return socket;
}

if (args[0] === "chat") {
  // A typed conversation in the terminal. Spoken turns show up here too.
  const input = createInterface({ input: process.stdin, output: process.stdout, prompt: "> " });
  const show = (text) => { process.stdout.write(`\r\x1b[K${text}\n`); input.prompt(true); };
  const dim = (text) => `\x1b[2m${text}\x1b[0m`;
  let waiting = false;
  createInterface({ input: open("watch") }).on("line", (line) => {
    const event = JSON.parse(line);
    if (event.type === "user" && !waiting) show(`> ${event.text}`);
    else if (event.type === "assistant") show(event.text);
    else if (event.type === "consult") show(dim(`consulting the Oracle: ${event.question}`));
    else if (event.type === "tool") show(dim(`using ${event.name}${event.args && Object.keys(event.args).length ? ` ${JSON.stringify(event.args)}` : ""}`));
    else if (event.type === "oracle") show(dim(`the Oracle answered: ${event.text}`));
    else if (event.type === "look") show(dim(`looking at the ${event.source}`));
    else if (event.type === "confirm") show(dim(event.done === undefined ? `proposed ${event.name} ${JSON.stringify(event.args ?? {})}` : event.done ? `carried out ${event.name}` : `dropped ${event.name}`));
    else if (event.type === "memory") show(dim(event.rewritten ? `reorganized ${event.topic}` : `remembered under ${event.topic}: ${event.note}`));
    else if (event.type === "recall") show(dim(`recalling ${event.topic}`));
    else if (event.type === "error") show(`error: ${event.message}`);
    else if (event.type === "new") { process.stdout.write("\x1b[2J\x1b[H"); input.prompt(true); }
    else if (event.type === "state" && event.state === "idle") waiting = false;
  });
  input.prompt();
  input.on("line", (line) => {
    const text = line.trim();
    if (text === "/new" || text === "/interview" || text === "/stop") open(text.slice(1)).resume();
    else if (text) { waiting = true; open(`type ${text}`).resume(); }
    input.prompt();
  });
  input.on("close", () => process.exit(0));
} else {
  open(args.join(" ")).pipe(process.stdout);
}

[Unit]
Description=heyclaude voice assistant daemon
After=pipewire.service
# It may be started before the login keyring is unlocked, and then cannot read
# its own memory: keep trying rather than giving up after a few quick failures.
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/node %h/Documents/Scripts/heyclaude/daemon.mjs
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
